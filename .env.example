# Dobby's development environment, loaded by config/runtime.exs in dev only.
# Copy to .env (gitignored) and fill in. Anything exported in the shell
# still wins over this file.
#
# Credentials for Home Assistant *integrations* (Honeywell TCC, etc.) do NOT
# belong here or anywhere in this repo — they are entered once in the HA UI
# and live in HA's own gitignored storage (dev/home-assistant/config/).

# Which house to boot. Unset = the FakeHA rig (config/homes/rig.exs).
DOBBY_HOME_MANIFEST=config/homes/local.yaml

# The local Home Assistant and the long-lived token dev/home-assistant/
# onboard.exs printed. Both are named by config/homes/local.yaml as
# `env:DOBBY_HA_URL` and `env:DOBBY_HA_TOKEN`, so the house file stays
# shareable and the credential lives here.
DOBBY_HA_URL=http://localhost:8123
DOBBY_HA_TOKEN=

# The one model-provider credential Dobby needs. The key stays in .env; the
# model stays explicit below and can change without changing credentials.
OPENROUTER_API_KEY=

# The model behind the `:capable` alias (design §2.1). Unset = the committed
# OpenRouter Luna default in config/config.exs. This line is a per-shell
# override; the durable place for it is the home file's `system` section,
# which works in every environment rather than only in dev.
# DOBBY_MODEL=openrouter:openai/gpt-5.6-luna
# DOBBY_MODEL=openrouter:z-ai/glm-5.3-flash
#
# How the model answers — `reasoning` and `routing` — has no environment
# override. Both live in the home file's `system` section only.

# Open the dev server to the household: bind every interface and advertise
# this machine as http://dobby.local/ while the server runs. With PORT=80
# (unprivileged on macOS) the address needs no port number. Both of these also
# live in the home file's `system` section now; exported still wins.
# DOBBY_LAN=1
# PORT=80
