# Dobby's service environment: /opt/dobby/config/dobby.env, owned by dobby,
# mode 600. This file is every credential the house has (TK-048).
# systemd reads it: KEY=value, one per line, no `export`, no quotes needed.

# Postgres on this box. The role and the database are created once; see
# https://mhyrr.github.io/dobby/box.html
DATABASE_URL=ecto://dobby:CHANGE-ME@localhost/dobby

# Signs the session and the ten-year name cookie. Generate once and keep it —
# change it and every browser in the house is asked its name again.
#     openssl rand -base64 48
SECRET_KEY_BASE=CHANGE-ME

# Home Assistant, which the house file names as env:DOBBY_HA_URL and
# env:DOBBY_HA_TOKEN. A long-lived token is full admin over Home Assistant.
DOBBY_HA_URL=http://homeassistant.local:8123
DOBBY_HA_TOKEN=CHANGE-ME

# The model provider.
OPENROUTER_API_KEY=CHANGE-ME

# The address the household types. `system.lan` and `system.port` in the house
# file are the durable places for the LAN bind and the port; these win when set.
PHX_HOST=dobby.local
# DOBBY_LAN=1
# PORT=80

# The two household files. These are the defaults; set them to move the files.
# DOBBY_HOME_MANIFEST=/opt/dobby/config/home.yaml
# DOBBY_SOUL=/opt/dobby/config/soul.md
