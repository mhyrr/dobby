# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
dobby-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# Playwright writes screenshots and page snapshots here while a surface is
# being looked at. They are evidence for a conversation, not for the repo.
/.playwright-mcp/


# macOS writes these into any directory Finder has looked at.
.DS_Store

# The local Home Assistant container's runtime state. HA writes its entire
# world here — including .storage/, which holds user accounts and every
# issued token. Nothing under it may ever be committed.
/dev/home-assistant/config/

# Local development environment — carries the HA token. .env.example is the
# committed shape of it.
/.env

# Agent worktrees. Ephemeral checkouts a subagent works in; git records them
# as gitlinks if they are ever staged, which is never what anyone meant.
/.claude/worktrees/

# Impeccable review captures: regenerated every finish round, never source
/.impeccable/review/
